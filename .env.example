# Copy to .env for LOCAL DEVELOPMENT ONLY.
#
#   cp .env.example .env
#
# .env is gitignored. Never put a real credential in a tracked file.
#
# In production this file is not used at all. `docker compose` no longer sets
# `env_file`, so the container gets its configuration from the `environment:`
# block in docker-compose.yml, where GITEA_TOKEN and OWUI_TOKEN are interpolated
# from Gitea secrets by the deploy workflow (.gitea/workflows/deploy.yml).
#
# Only `app/config.py` reads .env, via load_dotenv(), and only when the service
# is run outside Docker (e.g. uvicorn locally).

# ── Gitea ────────────────────────────────────────────────────────────────────
GITEA_INSTANCE_URL=https://gitea.yourdomain.com
# Personal access token. Needs repo scope. Use a dedicated machine account
# rather than your own admin token -- this credential can read and write every
# repository the account can see.
GITEA_TOKEN=

# Size limit for GiteaEditFile: the tool rewrites a whole file in memory, so
# an enormous file is refused instead of loaded. Gitea returns the full
# base64 body for a GET, so the cost is real.
GITEA_EDIT_MAX_BYTES=1000000

# ── Open-WebUI ───────────────────────────────────────────────────────────────
OWUI_INSTANCE_URL=http://localhost:8080
# Open-WebUI API key (Settings -> Account -> API Keys). Used by the notes sync.
OWUI_TOKEN=

# ── Notes sync ───────────────────────────────────────────────────────────────
# Knowledge Base ID to sync notes into (create a KB in Open-WebUI first, then
# grab its ID). Leave empty to disable the sync.
NOTES_SYNC_KB_ID=
# Sync interval in seconds (default: 300 = 5 minutes). Set to 0 to disable
# automatic sync.
NOTES_SYNC_INTERVAL=300

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=info

# ── TLS ──────────────────────────────────────────────────────────────────────
# Point at a CA bundle that trusts your Gitea certificate. Required when Gitea
# uses a self-signed cert, otherwise every API call fails TLS.
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
